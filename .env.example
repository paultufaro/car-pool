# Local Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://carpool:carpool@localhost:5432/carpool?schema=public"

# Signing key for session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="dev-only-insecure-secret-change-me"

# Verification codes are logged (and surfaced in the UI) when true. Ignored when NODE_ENV=production.
SHOW_DEV_VERIFICATION_CODES="true"

# Optional geocoding provider. Without a key, a built-in Summit-NJ-area gazetteer is used.
# GEOCODER=mapbox
# MAPBOX_TOKEN=

# Bearer token for POST /api/cron/reminders. Required — the endpoint refuses to run without it.
CRON_SECRET="dev-only-insecure-cron-secret-change-me"

# Optional notification providers. Without keys, notifications are logged to the database only.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
